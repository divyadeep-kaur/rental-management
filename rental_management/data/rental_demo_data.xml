            <field name="duration_unit">day</field>
            <field name="duration">3</field>
            <field name="state">reserved</field>
            <field name="planned_pickup_date" eval="(DateTime.today() + relativedelta(days=-1)).strftime('%Y-%m-%d 10:00:00')"/>
            <field name="planned_return_date" eval="(DateTime.today() + relativedelta(days=2)).strftime('%Y-%m-%d 17:00:00')"/>
        </record>

        <record id="rental_demo_order_3" model="rental.order">
            <field name="partner_id" ref="rental_demo_partner_lena"/>
            <field name="state">picked_up</field>
            <field name="rental_start_date" eval="(DateTime.today() + relativedelta(days=-3)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="rental_end_date" eval="(DateTime.today() + relativedelta(days=1)).strftime('%Y-%m-%d 17:00:00')"/>
        </record>
        <record id="rental_demo_order_3_line" model="rental.order.line">
            <field name="order_id" ref="rental_demo_order_3"/>
            <field name="product_id" model="product.template" eval="obj(ref('rental_management.rental_demo_product_projector')).product_variant_id.id"/>
