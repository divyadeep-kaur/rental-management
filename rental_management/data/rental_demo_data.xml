        </record>
        <record id="rental_demo_partner_marco" model="res.partner">
            <field name="name">Marco Rossi</field>
            <field name="email">marco.rossi@example.com</field>
            <field name="phone">+1 555-330-8842</field>
            <field name="city">Denver</field>
            <field name="customer_rank">1</field>
        </record>
        <record id="rental_demo_partner_lena" model="res.partner">
            <field name="name">Lena Schmidt</field>
            <field name="email">lena.schmidt@example.com</field>
            <field name="phone">+1 555-118-2290</field>
