            <field name="duration_unit">day</field>
            <field name="duration">2</field>
            <field name="state">returned</field>
            <field name="planned_pickup_date" eval="(DateTime.today() + relativedelta(days=-16)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="planned_return_date" eval="(DateTime.today() + relativedelta(days=-14)).strftime('%Y-%m-%d 17:00:00')"/>
            <field name="actual_pickup_date" eval="(DateTime.today() + relativedelta(days=-16)).strftime('%Y-%m-%d 09:05:00')"/>
            <field name="actual_return_date" eval="(DateTime.today() + relativedelta(days=-14)).strftime('%Y-%m-%d 20:00:00')"/>
            <field name="late_fee">9.0</field>
        </record>

    </data>
</odoo>
