            <field name="phone">+1 555-664-7723</field>
            <field name="city">Boston</field>
            <field name="customer_rank">1</field>
        </record>

        <!-- Rentable products -->
        <record id="rental_demo_product_bike" model="product.template">
            <field name="name">Mountain Bike</field>
            <field name="type">product</field>
            <field name="rent_ok">True</field>
            <field name="list_price">25.0</field>
            <field name="extra_hourly_late_fee">3.0</field>
        </record>
        <record id="rental_demo_pricing_bike_day" model="rental.pricing">
            <field name="product_tmpl_id" ref="rental_demo_product_bike"/>
            <field name="duration_unit">day</field>
            <field name="price">15.0</field>
        </record>

        <record id="rental_demo_product_camera" model="product.template">
            <field name="name">DSLR Camera Kit</field>
            <field name="type">product</field>
            <field name="rent_ok">True</field>
            <field name="list_price">60.0</field>
            <field name="extra_hourly_late_fee">5.0</field>
        </record>
        <record id="rental_demo_pricing_camera_day" model="rental.pricing">
            <field name="product_tmpl_id" ref="rental_demo_product_camera"/>
            <field name="duration_unit">day</field>
            <field name="price">45.0</field>
        </record>

        <record id="rental_demo_product_projector" model="product.template">
            <field name="name">Projector</field>
            <field name="type">product</field>
            <field name="rent_ok">True</field>
            <field name="list_price">40.0</field>
            <field name="extra_hourly_late_fee">4.0</field>
        </record>
        <record id="rental_demo_pricing_projector_day" model="rental.pricing">
            <field name="product_tmpl_id" ref="rental_demo_product_projector"/>
            <field name="duration_unit">day</field>
            <field name="price">30.0</field>
        </record>

        <record id="rental_demo_product_tent" model="product.template">
            <field name="name">4-Person Camping Tent</field>
            <field name="type">product</field>
            <field name="rent_ok">True</field>
            <field name="list_price">35.0</field>
            <field name="extra_hourly_late_fee">2.5</field>
        </record>
        <record id="rental_demo_pricing_tent_day" model="rental.pricing">
            <field name="product_tmpl_id" ref="rental_demo_product_tent"/>
            <field name="duration_unit">day</field>
            <field name="price">20.0</field>
        </record>

        <!-- Give the demo products some stock to rent out -->
        <function model="stock.quant" name="_update_available_quantity">
            <value model="product.template" eval="obj(ref('rental_management.rental_demo_product_bike')).product_variant_id"/>
            <value model="stock.location" eval="obj(ref('stock.stock_location_stock'))"/>
            <value eval="5"/>
        </function>
        <function model="stock.quant" name="_update_available_quantity">
            <value model="product.template" eval="obj(ref('rental_management.rental_demo_product_camera')).product_variant_id"/>
            <value model="stock.location" eval="obj(ref('stock.stock_location_stock'))"/>
            <value eval="3"/>
        </function>
        <function model="stock.quant" name="_update_available_quantity">
            <value model="product.template" eval="obj(ref('rental_management.rental_demo_product_projector')).product_variant_id"/>
            <value model="stock.location" eval="obj(ref('stock.stock_location_stock'))"/>
            <value eval="4"/>
        </function>
        <function model="stock.quant" name="_update_available_quantity">
            <value model="product.template" eval="obj(ref('rental_management.rental_demo_product_tent')).product_variant_id"/>
            <value model="stock.location" eval="obj(ref('stock.stock_location_stock'))"/>
            <value eval="6"/>
        </function>

        <!-- Rental orders across the lifecycle -->
        <record id="rental_demo_order_1" model="rental.order">
            <field name="partner_id" ref="rental_demo_partner_aisha"/>
            <field name="rental_start_date" eval="(DateTime.today() + relativedelta(days=1)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="rental_end_date" eval="(DateTime.today() + relativedelta(days=4)).strftime('%Y-%m-%d 18:00:00')"/>
        </record>
        <record id="rental_demo_order_1_line" model="rental.order.line">
            <field name="order_id" ref="rental_demo_order_1"/>
            <field name="product_id" model="product.template" eval="obj(ref('rental_management.rental_demo_product_bike')).product_variant_id.id"/>
            <field name="quantity">2</field>
            <field name="duration_unit">day</field>
            <field name="duration">3</field>
            <field name="planned_pickup_date" eval="(DateTime.today() + relativedelta(days=1)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="planned_return_date" eval="(DateTime.today() + relativedelta(days=4)).strftime('%Y-%m-%d 18:00:00')"/>
        </record>

        <record id="rental_demo_order_2" model="rental.order">
            <field name="partner_id" ref="rental_demo_partner_marco"/>
