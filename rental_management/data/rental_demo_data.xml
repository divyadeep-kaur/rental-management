            <field name="actual_return_date" eval="(DateTime.today() + relativedelta(days=-7)).strftime('%Y-%m-%d 16:40:00')"/>
        </record>

        <record id="rental_demo_order_5" model="rental.order">
            <field name="partner_id" ref="rental_demo_partner_priya"/>
            <field name="state">returned</field>
            <field name="payment_type">partial</field>
            <field name="deposit_percentage">40.0</field>
            <field name="rental_start_date" eval="(DateTime.today() + relativedelta(days=-16)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="rental_end_date" eval="(DateTime.today() + relativedelta(days=-14)).strftime('%Y-%m-%d 17:00:00')"/>
        </record>
        <record id="rental_demo_order_5_line" model="rental.order.line">
            <field name="order_id" ref="rental_demo_order_5"/>
