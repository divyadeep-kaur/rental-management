<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rental_pricing_view_tree" model="ir.ui.view">
        <field name="name">rental.pricing.tree</field>
        <field name="model">rental.pricing</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="product_tmpl_id"/>
                <field name="pricelist_id"/>
                <field name="duration_unit"/>
                <field name="price"/>
                <field name="discount"/>
            </tree>
        </field>
    </record>

    <record id="action_rental_pricing" model="ir.actions.act_window">
        <field name="name">Rental Pricing</field>
        <field name="res_model">rental.pricing</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
