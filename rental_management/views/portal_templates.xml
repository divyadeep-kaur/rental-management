<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="rental_shop_page" name="Rental Shop">
        <t t-call="portal.frontend_layout">
            <div id="wrap" class="o_rental_shop_wrap">
                <div class="o_rental_hero">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-12 col-lg-7">
                                <div class="o_rental_hero_kicker">Rental Management</div>
                                <h1 class="o_rental_hero_title">Rent what you need,<br/>whenever you need it.</h1>
                                <p class="o_rental_hero_subtitle">
                                    Browse our equipment, pick your dates, and request a rental in
                                    a couple of clicks. No paperwork, no phone calls.
                                </p>
                                <div class="d-flex flex-wrap align-items-center gap-3">
                                    <div class="o_rental_search">
                                        <input type="text" data-rental-search="1" placeholder="Search equipment..." autocomplete="off"/>
                                    </div>
                                    <a href="#rental-catalog" class="o_rental_hero_ghost_link">Browse catalog &#8595;</a>
                                </div>
                                <div class="o_rental_hero_stats">
                                    <div class="o_rental_hero_stat">
                                        <div class="o_rental_hero_stat_value" t-out="len(products)"/>
                                        <div class="o_rental_hero_stat_label">Items available</div>
                                    </div>
                                    <div class="o_rental_hero_stat">
                                        <div class="o_rental_hero_stat_value">24h</div>
                                        <div class="o_rental_hero_stat_label">Same-day pickup</div>
                                    </div>
                                    <div class="o_rental_hero_stat">
                                        <div class="o_rental_hero_stat_value">0%</div>
                                        <div class="o_rental_hero_stat_label">Booking fees</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-5 d-none d-lg-block">
                                <t t-if="products">
                                    <t t-set="preview" t-value="products[0]"/>
                                    <div class="o_rental_hero_card">
                                        <div class="o_rental_hero_card_badge">Available now</div>
                                        <div class="o_rental_hero_card_title" t-out="preview.name"/>
                                        <div class="o_rental_hero_card_price">
                                            <span t-out="preview.rental_day_price" t-options="{'widget': 'monetary', 'display_currency': preview.currency_id}"/>
                                            <span class="o_rental_hero_card_unit">/ day</span>
                                        </div>
                                        <div class="o_rental_hero_card_footer">
                                            <span class="o_rental_hero_card_dot"/>
                                            Ready to book
                                        </div>
                                    </div>
                                    <div class="o_rental_hero_card o_rental_hero_card_back"/>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="o_rental_grid_section" id="rental-catalog">
                    <div class="container pb-5">
                        <div class="row g-4">
                            <t t-foreach="products" t-as="product">
                                <div class="col-12 col-sm-6 col-lg-4" data-rental-card="1" t-att-data-rental-name="product.name">
                                    <a t-attf-href="/rental/shop/#{product.id}" class="text-decoration-none">
                                        <div class="o_rental_card" t-attf-style="animation-delay: #{product_index * 0.06}s">
                                            <div class="o_rental_card_image"
                                                 t-attf-style="background-image: url(/web/image/product.template/#{product.id}/image_1024);"/>
                                            <div class="o_rental_card_body">
                                                <div class="o_rental_card_title" t-out="product.name"/>
                                                <div class="o_rental_card_price">
                                                    From
                                                    <span t-out="product.rental_day_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                                                    / day
                                                </div>
                                                <div class="o_rental_card_cta">View details &#8594;</div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </t>
                        </div>
                        <t t-if="not products">
                            <div class="o_rental_empty_state">
                                <p>No rental products are available right now.</p>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="rental_shop_product_page" name="Rental Product">
        <t t-call="portal.frontend_layout">
            <div id="wrap" class="o_rental_shop_wrap">
                <div class="container py-5">
                    <a href="/rental/shop" class="o_rental_back_link">&#8592; Back to shop</a>
                    <div class="row mt-3 g-5">
                        <div class="col-12 col-md-6">
                            <div class="o_rental_product_image"
                                 t-attf-style="background-image: url(/web/image/product.template/#{product.id}/image_1024);"/>
                        </div>
                        <div class="col-12 col-md-6">
                            <h1 t-out="product.name"/>
                            <p class="text-muted" t-out="product.description_sale"/>

                            <t t-if="error">
                                <div class="alert alert-danger">Please check the quantity and dates and try again.</div>
                            </t>

                            <table class="table o_rental_pricing_table">
                                <thead>
                                    <tr><th>Duration</th><th>Price</th></tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="product.rental_pricing_ids.filtered(lambda p: not p.pricelist_id)" t-as="rate">
                                        <tr>
                                            <td>
                                                Per <span t-out="rate.duration_unit"/>
                                            </td>
                                            <td>
                                                <span t-out="rate.price" t-options="{'widget': 'monetary', 'display_currency': rate.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <t t-if="is_public_user">
                                <div class="o_rental_signin_prompt">
                                    <p>Sign in to request this rental.</p>
                                    <a t-attf-href="/web/login?redirect=/rental/shop/#{product.id}" class="btn btn-primary o_rental_cta">Sign in</a>
                                </div>
                            </t>
                            <t t-else="">
                                <script type="application/json" id="rental-pricing-data"><t t-out="pricing_json"/></script>
                                <form action="/rental/request" method="post" class="o_rental_booking_form" data-rental-booking-form="1">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="product_id" t-att-value="product.id"/>

                                    <div class="mb-3">
                                        <label class="form-label d-block">Quantity</label>
                                        <div class="o_rental_qty_stepper" data-rental-stepper="1">
                                            <button type="button" data-delta="-1">-</button>
                                            <input type="number" name="quantity" value="1" min="1"/>
                                            <button type="button" data-delta="1">+</button>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6 mb-3">
                                            <label class="form-label">Duration</label>
                                            <input type="number" name="duration" class="form-control" t-att-value="product.min_rental_duration or 1" min="1"/>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <label class="form-label">Unit</label>
                                            <select name="duration_unit" class="form-select">
                                                <option value="hour">Hour</option>
                                                <option value="day" selected="selected">Day</option>
                                                <option value="week">Week</option>
                                                <option value="month">Month</option>
                                                <option value="year">Year</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6 mb-3">
                                            <label class="form-label">Pickup date</label>
                                            <input type="datetime-local" name="planned_pickup_date" class="form-control"/>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <label class="form-label">Return date</label>
                                            <input type="datetime-local" name="planned_return_date" class="form-control"/>
                                        </div>
                                    </div>

                                    <div class="o_rental_estimate">
                                        <span class="o_rental_estimate_label">Estimated total</span>
                                        <span class="o_rental_estimate_value" data-rental-estimate="1">$0.00</span>
                                    </div>

                                    <button type="submit" class="btn btn-primary o_rental_cta w-100 mt-3">Request this rental</button>
                                </form>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_my_rentals" name="My Rentals">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="o_portal_my_doc_table">
                <t t-if="not orders">
                    <p class="text-muted">You don't have any rentals yet. <a href="/rental/shop">Browse the shop</a>.</p>
                </t>
                <t t-if="orders">
                    <table class="table o_rental_pricing_table">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Rental Start</th>
                                <th>Rental End</th>
                                <th>Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="orders" t-as="order">
                                <tr>
                                    <td><a t-attf-href="/my/rentals/#{order.id}" t-out="order.name"/></td>
                                    <td t-out="order.rental_start_date"/>
                                    <td t-out="order.rental_end_date"/>
                                    <td>
                                        <span t-out="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                    </td>
                                    <td>
                                        <span t-attf-class="badge o_rental_badge o_rental_badge_#{order.state}" t-out="order.state"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <t t-call="portal.pager"/>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_rental_detail" name="Rental Order Detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <t t-set="state_order" t-value="['draft', 'confirmed', 'picked_up', 'returned']"/>
            <t t-set="effective_state" t-value="'draft' if order.state == 'sent' else order.state"/>
            <t t-set="current_index" t-value="state_order.index(effective_state) if effective_state in state_order else -1"/>
            <div class="container py-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="mb-0" t-out="order.name"/>
                    <span t-attf-class="badge o_rental_badge o_rental_badge_#{order.state}" t-out="order.state"/>
                </div>

                <div class="o_rental_status_track">
                    <t t-foreach="state_order" t-as="step">
                        <div class="o_rental_step_wrap">
                            <div t-attf-class="o_rental_step #{'active' if step_index == current_index else ('done' if step_index &lt; current_index else '')}">
                                <div class="o_rental_step_dot">
                                    <t t-if="step_index &lt; current_index">&#10003;</t>
                                    <t t-else=""><t t-out="step_index + 1"/></t>
                                </div>
                                <div class="o_rental_step_label" t-out="step.replace('_', ' ')"/>
                            </div>
                            <t t-if="not step_index == len(state_order) - 1">
                                <div class="o_rental_step_line">
                                    <div class="o_rental_step_line_fill" t-attf-style="width: #{100 if step_index &lt; current_index else 0}%"/>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>

                <div class="o_rental_detail_card">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Duration</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="order.order_line_ids" t-as="line">
                                <tr>
                                    <td t-out="line.product_id.display_name"/>
                                    <td t-out="line.quantity"/>
                                    <td>
                                        <span t-out="line.duration"/> <span t-out="line.duration_unit"/>
                                    </td>
                                    <td>
                                        <span t-out="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div class="text-end pt-3 border-top mt-3">
                        <strong>Total: </strong>
                        <span t-out="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
