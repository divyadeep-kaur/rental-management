<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rental_order_view_form" model="ir.ui.view">
        <field name="name">rental.order.form</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <form string="Rental Order">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_pickup" type="object" string="Mark Picked Up" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_return" type="object" string="Mark Returned" class="oe_highlight" invisible="state != 'picked_up'"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice" invisible="state not in ('confirmed', 'picked_up', 'returned')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('cancelled', 'picked_up', 'returned')"/>
                    <button name="action_draft" type="object" string="Set to Draft" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,picked_up,returned"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="pricelist_id"/>
                            <field name="date_order"/>
                        </group>
                        <group>
                            <field name="rental_start_date"/>
                            <field name="rental_end_date"/>
                            <field name="payment_type"/>
                            <field name="deposit_percentage" invisible="payment_type != 'partial'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rental Lines" name="rental_lines">
                            <field name="order_line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="duration_unit"/>
                                    <field name="duration"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" sum="Total"/>
                                    <field name="planned_pickup_date"/>
                                    <field name="planned_return_date"/>
                                    <field name="actual_pickup_date" readonly="1" optional="hide"/>
                                    <field name="actual_return_date" readonly="1" optional="hide"/>
                                    <field name="late_fee" readonly="1" optional="hide"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer">
                        <field name="amount_untaxed"/>
                        <field name="late_fee_total"/>
                        <field name="amount_total" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rental_order_view_tree" model="ir.ui.view">
        <field name="name">rental.order.tree</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="rental_start_date"/>
                <field name="rental_end_date"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'returned'" decoration-info="state == 'confirmed'" decoration-warning="state == 'picked_up'" decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="rental_order_view_search" model="ir.ui.view">
        <field name="name">rental.order.search</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Quotations" name="draft" domain="[('state', 'in', ('draft', 'sent'))]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Picked Up" name="picked_up" domain="[('state', '=', 'picked_up')]"/>
                <filter string="Returned" name="returned" domain="[('state', '=', 'returned')]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rental_order" model="ir.actions.act_window">
        <field name="name">Rental Orders</field>
        <field name="res_model">rental.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first rental quotation
            </p>
        </field>
    </record>
</odoo>
